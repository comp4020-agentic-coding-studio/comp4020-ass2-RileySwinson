---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Comply is taught in two parts. In weeks 1 to 6, students attend weekly
    workshops, in which the course content is delivered. In weeks 7 to 12,
    students attend weekly lectures, each of which includes an in-lecture
    assessment.
  </p>
  <p>
    Each workshop and lecture addresses one requirement of university study:
    reading a class summary, meeting a due date, attending a timetabled
    activity, requesting an extension. Students will complete the course having met each of these
    requirements at least once, under assessment conditions.
  </p>

  <h2>Who it is for</h2>
  <p>
    Comply is a compulsory first-year course. It is intended for students who
    will go on to complete other courses at Slop University. Students are
    assumed to have achieved a level of knowledge equivalent to this course.
  </p>

  <h2>Before week 1</h2>
  <p>
    Read the <a href={withBase("/class-summary/")}>class summary</a>.
    It is the authoritative statement of the course's requirements, and it is
    examinable.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Class summary" href="/class-summary/">
      <p>The course's requirements, prescribed texts and learning outcomes.</p>
    </Card>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>Weeks 1 to 6. Workshops are not recorded.</p>
    </Card>
    <Card title="Lectures" href="/lectures/">
      <p>Weeks 7 to 12. Each lecture includes an assessed component.</p>
    </Card>
    <Card title="Timetable" href="/timetable/">
      <p>Every scheduled activity, with its current time.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="Policies" href="/policies/">
      <p>Extensions, appeals, attendance and the use of artificial intelligence.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
