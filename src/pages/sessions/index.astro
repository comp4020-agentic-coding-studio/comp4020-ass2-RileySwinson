---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Workshops in weeks 1 to 6, and the Lab A stream in weeks 7 to 12."
  {...siteConfig}
>
  <p>
    Workshops run in weeks 1 to 6. Each workshop is followed by a drop-in
    session. Workshops are not recorded. Lab A runs weekly in weeks 7 to 12.
  </p>
  <SessionsGrid />
</ContentLayout>
