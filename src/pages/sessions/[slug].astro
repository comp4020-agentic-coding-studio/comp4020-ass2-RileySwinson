---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import CourseStaff from "../../components/CourseStaff.astro";
import { formatCourseDay, formatSlot } from "../../lib/dates";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content } = await render(session);
// Timetable facts live in frontmatter only (CLAUDE.md, "Facts"); the page
// renders them rather than the prose restating them.
const data = session.data as typeof session.data & {
  kind?: string;
  start?: string;
  end?: string;
  dropInEnd?: string;
  recorded?: boolean;
};
const isLab = data.kind === "lab";
const isBreak = data.kind === "break";
const title = isLab ? data.title : isBreak ? `Week ${data.week}: ${data.title}` : `Week ${data.week} ${sessionLabels.singular}: ${data.title}`;
---

<ContentLayout title={title} description={data.description} {...siteConfig}>
  <dl class="slot">
    <CourseStaff teachers={data.teachers} />
    <dt>Date</dt>
    <dd>{formatCourseDay(data.date)}</dd>
    {formatSlot(data.start, data.end) && (<dt>Time</dt><dd>{formatSlot(data.start, data.end)}</dd>)}
    {data.dropInEnd && data.end && (<dt>Drop-in session</dt><dd>{formatSlot(data.end, data.dropInEnd)}</dd>)}
    {!isBreak && (<><dt>Recording</dt>
    <dd>{data.recorded === false ? (isLab ? "This lab is not recorded." : "This workshop is not recorded.") : "Recorded."}</dd></>)}
  </dl>
  <Content />
  <RelatedContent entry={session} collections={graphCollections} />
</ContentLayout>

<style>
  .slot {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    margin-block: 0 1.5rem;
  }
  .slot :global(dt) {
    font-weight: 700;
  }
  .slot :global(dd) {
    margin: 0;
  }
</style>
