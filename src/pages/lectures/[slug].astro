---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDay, formatSlot } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const data = lecture.data as typeof lecture.data & {
  start?: string;
  end?: string;
  moved?: boolean;
  movedFrom?: string;
  recorded?: boolean;
  inLectureAssessment?: boolean;
};
const title = `Week ${data.week}: ${data.title}`;
---

<ContentLayout title={title} description={data.description} {...siteConfig}>
  <dl class="slot">
    <dt>Date</dt>
    <dd>{formatCourseDay(data.date)}</dd>
    {formatSlot(data.start, data.end) && (<dt>Time</dt><dd>{formatSlot(data.start, data.end)}</dd>)}
    {data.moved && (<dt>Rescheduled</dt><dd>This lecture has been rescheduled{data.movedFrom ? ` from ${data.movedFrom}` : ""}. The time above is the current time.</dd>)}
    <dt>Recording</dt>
    <dd>{data.recorded ? "This lecture is recorded." : "This lecture is not recorded."}</dd>
    {data.inLectureAssessment && (
      <><dt>Assessment</dt><dd>This lecture includes an <a href={withBase("/assessments/in-lecture-assessment/")}>in-lecture assessment</a>.</dd></>
    )}
  </dl>
  {data.slides && <p><a href={withBase(data.slides)}>Open the slides</a></p>}
  <Content />
  <TeachingTeam teachers={data.teachers} />
  <RelatedContent entry={lecture} collections={graphCollections} />
</ContentLayout>

<style>
  .slot {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    margin-block: 0 1.5rem;
  }
  .slot dt {
    font-weight: 700;
  }
  .slot dd {
    margin: 0;
  }
</style>
